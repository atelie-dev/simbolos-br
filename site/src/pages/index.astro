---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Base from "../layouts/Base.astro";
import Busca from "../components/Busca.astro";
import Topo from "../components/Topo.astro";
import Rodape from "../components/Rodape.astro";
import { BASE as base, SPONSORS, embedUrl } from "../lib/urls";

// Gerado por `simbolos indice` antes do build; lido do disco para não depender
// de como o bundler trata import de JSON em `public/`.
const resumo = JSON.parse(
  readFileSync(resolve(process.cwd(), "public/api/v1/resumo.json"), "utf8"),
) as {
  versao: string;
  municipios: number;
  publicados: number;
  municipios_cobertos: number;
  cobertura_pct: number;
  municipios_com_brasao: number;
  vetoriais: number;
  por_uf: { uf: string; nome: string; total: number; brasao: number; bandeira: number; vetorial: number }[];
};

const faltam = resumo.municipios - resumo.municipios_cobertos;
const taxa = (x: { brasao: number; total: number }) => x.brasao / x.total;
const piores = [...resumo.por_uf].sort((a, b) => taxa(a) - taxa(b)).slice(0, 5);
const melhores = [...resumo.por_uf].sort((a, b) => taxa(b) - taxa(a)).slice(0, 5);

const exemplo = { codigo: "3550308", nome: "São Paulo", uf: "SP" };
const num = (n: number) => n.toLocaleString("pt-BR");
const pct = resumo.cobertura_pct.toLocaleString("pt-BR", { minimumFractionDigits: 1 });

const destaques = JSON.parse(
  readFileSync(resolve(process.cwd(), "src/data/destaques.json"), "utf8"),
) as { c: string; n: string; u: string }[];
---

<Base title="Símbolos · coletivo.dev.br">
  <Topo atual="inicio" />

  <main id="conteudo">
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-texto">
          <p class="eyebrow">Acervo aberto · {resumo.versao}</p>
          <h1>Os símbolos do Brasil, em um só lugar.</h1>
          <p class="linha-fina">
            Brasões e bandeiras de municípios e estados, com procedência, licença
            por arquivo e uma URL estável para citar ou embutir em qualquer documento.
          </p>
          <Busca />
          <p class="geo">
            <button type="button" class="geo-botao" id="geo" data-base={base}>
              Ver o brasão da cidade onde estou
            </button>
            <span class="geo-estado" id="geo-estado" role="status" aria-live="polite"></span>
          </p>
          <p class="geo-nota">
            Cruza sua posição com a malha municipal do IBGE, dentro do navegador.
            Nada é enviado para servidor nosso.
          </p>
          <dl class="numeros">
            <div>
              <dt>municípios</dt>
              <dd class="num">{num(resumo.municipios)}</dd>
            </div>
            <div>
              <dt>itens publicados</dt>
              <dd class="num">{num(resumo.publicados)}</dd>
            </div>
            <div>
              <dt>cobertura</dt>
              <dd class="num">{pct}%</dd>
            </div>
            <div>
              <dt>itens vetoriais</dt>
              <dd class="num">{num(resumo.vetoriais)}</dd>
            </div>
          </dl>
        </div>

        <div class="hero-arte" aria-hidden="true">
          <figure class="arte arte--1">
            <img data-arte src={embedUrl("3550308", "brasao", "png")} alt="" width="190" height="190" />
          </figure>
          <figure class="arte arte--2">
            <img data-arte src={embedUrl("3304557", "bandeira", "png")} alt="" width="160" height="160" />
          </figure>
          <figure class="arte arte--3">
            <img data-arte src={embedUrl("3106200", "brasao", "png")} alt="" width="150" height="150" />
          </figure>
        </div>
      </div>
    </section>

    <section class="secao" id="usar">
      <div class="wrap">
        <p class="eyebrow">Use agora</p>
        <h2>Uma linha de HTML e o brasão está no seu documento.</h2>
        <div class="usar">
          <div class="amostra">
            <div class="xadrez">
              <img
                id="previa"
                src={embedUrl(exemplo.codigo, "brasao", "svg")}
                alt={`Brasão de ${exemplo.nome}`}
                width="180"
                height="180"
                loading="lazy"
              />
            </div>
            <p class="amostra-legenda">
              <span data-nome>{exemplo.nome}</span> · <span data-uf>{exemplo.uf}</span> ·{" "}
              <span class="num" data-cod>{exemplo.codigo}</span>
            </p>
          </div>

          <div class="codigo">
            <div class="opcoes" role="group" aria-label="Formato e tipo">
              <button type="button" class="opcao" data-ext="svg" aria-pressed="true">SVG</button>
              <button type="button" class="opcao" data-ext="png" aria-pressed="false">PNG</button>
              <button type="button" class="opcao" data-ext="jpg" aria-pressed="false">JPG</button>
              <span class="divisor" aria-hidden="true"></span>
              <button type="button" class="opcao" data-tipo="brasao" aria-pressed="true">Brasão</button>
              <button type="button" class="opcao" data-tipo="bandeira" aria-pressed="false">Bandeira</button>
            </div>
            <pre class="snippet"><code id="snippet"></code></pre>
            <div class="acoes">
              <button type="button" class="btn" id="copiar">Copiar código</button>
              <span class="dica" id="dica" aria-live="polite"></span>
            </div>
            <p class="nota">
            Todos os três formatos existem para todo item publicado. O mesmo caminho
            serve para <code>&lt;picture&gt;</code>, Markdown e CSS{" "}
            <code>mask</code>.
          </p>
          </div>
        </div>
      </div>
    </section>

    <section class="secao secao--alt" id="cobertura">
      <div class="wrap">
        <p class="eyebrow">Cobertura</p>
        <h2>{num(resumo.municipios_cobertos)} municípios já têm ao menos um símbolo.</h2>
        <p class="muted">
          Faltam <strong class="num">{num(faltam)}</strong> de {num(resumo.municipios)}.
          A medida não esconde o que falta: cada número tem numerador e denominador.
        </p>

        <div class="barra" role="img" aria-label={`Cobertura de ${pct}%`}>
          <span style={`width:${resumo.cobertura_pct}%`}></span>
        </div>
        <p class="barra-legenda">
          <span><strong class="num">{pct}%</strong> dos municípios</span>
          <span class="muted"><span class="num">{num(resumo.vetoriais)}</span> itens vetoriais</span>
        </p>

        <div class="duas-listas">
          <div>
            <h3>Mais completos</h3>
            <ul class="ufs">
              {melhores.map((u) => (
                <li>
                  <span class="uf">{u.uf}</span>
                  <span class="muted">{u.nome}</span>
                  <span class="num pct">{Math.round(taxa(u) * 100)}%</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3>Onde falta mais</h3>
            <ul class="ufs">
              {piores.map((u) => (
                <li>
                  <span class="uf">{u.uf}</span>
                  <span class="muted">{u.nome}</span>
                  <span class="num pct">{Math.round(taxa(u) * 100)}%</span>
                </li>
              ))}
            </ul>
            <p class="nota">
              Símbolo ausente não é símbolo inexistente: muitos municípios têm
              brasão publicado pela Câmara, em PDF, e ainda não entraram.{" "}
              <a href="#contribuir">Ajudar a encontrar</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="secao" id="porque">
      <div class="wrap">
        <p class="eyebrow">Por que existe</p>
        <h2>Quem precisa de um brasão não deveria abrir dez abas.</h2>
        <div class="cartoes">
          <article class="card cartao">
            <h3>Nota fiscal (DANFSE)</h3>
            <p>Sistemas municipais e contadores precisam do brasão correto por código IBGE, em 192 px.</p>
          </article>
          <article class="card cartao">
            <h3>Prefeituras e câmaras</h3>
            <p>Material próprio, site e documentos, sem depender de arquivo perdido em e-mail.</p>
          </article>
          <article class="card cartao">
            <h3>Jornalismo e pesquisa</h3>
            <p>Imagem com procedência declarada e licença legível, em vez de captura sem crédito.</p>
          </article>
          <article class="card cartao">
            <h3>Educação e apps</h3>
            <p>Projetos escolares, jogos e mapas que precisam do símbolo em formato leve e vetorial.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao--alt" id="contribuir">
      <div class="wrap">
        <p class="eyebrow">Contribuir</p>
        <h2>Três formas de fazer o acervo crescer.</h2>
        <div class="cartoes cartoes--tres">
          <article class="card cartao">
            <span class="numero">01</span>
            <h3>Tenho a imagem</h3>
            <p>Envie o arquivo que a prefeitura publicou. SVG é ouro; raster grande também serve.</p>
          </article>
          <article class="card cartao">
            <span class="numero">02</span>
            <h3>Conheço a fonte oficial</h3>
            <p>Um link de página da prefeitura ou o número da lei que instituiu o símbolo já resolve.</p>
          </article>
          <article class="card cartao">
            <span class="numero">03</span>
            <h3>Posso ajudar com dinheiro</h3>
            <p>Domínio, armazenamento e curadoria. Sem anúncio, sem vender destaque.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="secao" id="apoiar">
      <div class="wrap apoio">
        <div>
          <p class="eyebrow">Apoiar</p>
          <h2>O acervo não tem anúncio nem patrocínio.</h2>
          <p class="muted">
            O custo é domínio e armazenamento — pequeno, mas real. O apoio paga
            infraestrutura primeiro; depois, tempo de curadoria.
          </p>
        </div>
        <div class="apoio-acoes">
          <a class="btn" href={SPONSORS} target="_blank" rel="noopener">
            GitHub Sponsors
          </a>
          <button type="button" class="btn btn--ghost" disabled>PIX — chave em definição</button>
          <p class="nota">
            Sem anúncio, sem vender destaque e sem vender "verificação". O custo
            real entra no primeiro relatório mensal.
          </p>
        </div>
      </div>
    </section>

    <section class="secao secao--alt" id="confianca">
      <div class="wrap">
        <p class="eyebrow">Confiança</p>
        <h2>O que sustenta um acervo público.</h2>
        <div class="confianca">
          <div>
            <h3>Licença por arquivo</h3>
            <p>
              O acervo não tem uma licença só. Cada imagem carrega a sua, em SPDX,
              e o balde correspondente: livre, compartilha ou oficial.
            </p>
          </div>
          <div>
            <h3>Procedência visível</h3>
            <p>
              Origem, data de captura e hash ficam ao lado do arquivo. Correção de
              atribuição é parte do produto, não um pedido por e-mail.
            </p>
          </div>
          <div>
            <h3>Sem vínculo oficial</h3>
            <p>
              Projeto independente, sem relação com governo, IBGE ou prefeituras.
              O símbolo é do município; o acervo é só um lugar melhor para encontrá-lo.
            </p>
          </div>
          <div>
            <h3>Correção e contestação</h3>
            <p>
              Errou? A política de correção e takedown vale para qualquer item, com
              registro do que mudou e por quê.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Rodape />

  <script type="application/json" id="destaques" set:html={JSON.stringify(destaques)} />

  <script>
    const cdn = "https://simbolos.coletivo.dev.br";
    const destaques: { c: string; n: string; u: string }[] = JSON.parse(
      document.getElementById("destaques")?.textContent ?? "[]",
    );
    const sorteia = <T,>(lista: T[]): T => lista[Math.floor(Math.random() * lista.length)];

    /** Fisher-Yates: três municípios distintos no hero, nunca repetidos. */
    const embaralha = <T,>(lista: T[]): T[] => {
      const copia = [...lista];
      for (let i = copia.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copia[i], copia[j]] = [copia[j], copia[i]];
      }
      return copia;
    };
    const padrao = { c: "3550308", n: "São Paulo", u: "SP" };

    let municipio = destaques.length ? sorteia(destaques) : padrao;
    const estado = { ext: "svg", tipo: "brasao" };

    const snippet = document.getElementById("snippet") as HTMLElement | null;
    const previa = document.getElementById("previa") as HTMLImageElement | null;
    const dica = document.getElementById("dica") as HTMLElement | null;

    const atualizar = () => {
      const url = `${cdn}/embed/v1/${estado.tipo}/${municipio.c}.${estado.ext}`;
      const alt = `${estado.tipo === "brasao" ? "Brasão" : "Bandeira"} de ${municipio.n}`;
      if (snippet) snippet.textContent = `<img src="${url}" alt="${alt}" width="192" height="192">`;
      if (previa) {
        previa.src = url;
        previa.alt = alt;
      }
    };

    const legenda = () => {
      const por = (sel: string) => document.querySelector(sel);
      if (por("[data-nome]")) por("[data-nome]")!.textContent = municipio.n;
      if (por("[data-uf]")) por("[data-uf]")!.textContent = municipio.u;
      if (por("[data-cod]")) por("[data-cod]")!.textContent = municipio.c;
    };

    // Os três quadros do hero: dois brasões e uma bandeira, de municípios
    // diferentes a cada carga. Puro enfeite, então sem alt e aria-hidden.
    const trio = embaralha(destaques).slice(0, 3);
    document.querySelectorAll<HTMLImageElement>("img[data-arte]").forEach((img, indice) => {
      const escolhido = trio[indice] ?? trio[0];
      if (!escolhido) return;
      const tipo = indice === 1 ? "bandeira" : "brasao";
      img.src = `${cdn}/embed/v1/${tipo}/${escolhido.c}.png`;
    });

    document.querySelectorAll<HTMLButtonElement>(".opcao").forEach((botao) => {
      botao.addEventListener("click", () => {
        const grupo = botao.dataset.ext ? "ext" : "tipo";
        document.querySelectorAll<HTMLButtonElement>(`.opcao[data-${grupo}]`).forEach((b) => {
          b.setAttribute("aria-pressed", String(b === botao));
        });
        Object.assign(estado, { [grupo]: botao.dataset[grupo] });
        atualizar();
      });
    });

    document.getElementById("copiar")?.addEventListener("click", () => {
      const texto = snippet?.textContent ?? "";
      navigator.clipboard?.writeText(texto).then(() => {
        if (dica) {
          dica.textContent = "copiado";
          setTimeout(() => (dica.textContent = ""), 1500);
        }
      });
    });

    legenda();
    atualizar();
  </script>

  <script>
    // "Onde estou": a posição nunca sai do navegador. O ponto é testado contra a
    // malha municipal do IBGE, fatiada em células de 1° — só a célula do usuário
    // (e as vizinhas, se preciso) é baixada.
    const botaoGeo = document.getElementById("geo") as HTMLButtonElement | null;
    const estadoGeo = document.getElementById("geo-estado") as HTMLElement | null;
    const baseGeo = botaoGeo?.dataset.base ?? "/";

    type Ponto = [number, number, string, string];
    type Aneis = number[][][];
    type Celula = { t: [string, string, Aneis][] };

    const aviso = (texto: string) => {
      if (estadoGeo) estadoGeo.textContent = texto;
    };

    /** Par-ímpar sobre todos os anéis: resolve MultiPolygon e furos. */
    const dentro = (lon: number, lat: number, aneis: Aneis): boolean => {
      let contido = false;
      for (const anel of aneis) {
        for (let k = 0, l = anel.length - 1; k < anel.length; l = k++) {
          const [xk, yk] = anel[k];
          const [xl, yl] = anel[l];
          if (yk > lat !== yl > lat && lon < ((xl - xk) * (lat - yk)) / (yl - yk) + xk) {
            contido = !contido;
          }
        }
      }
      return contido;
    };

    const buscarCelula = async (i: number, j: number): Promise<Celula | null> => {
      try {
        const resposta = await fetch(`${baseGeo}api/v1/malha/${i}_${j}.json`, {
          cache: "force-cache",
        });
        return resposta.ok ? ((await resposta.json()) as Celula) : null;
      } catch {
        return null;
      }
    };

    /** Célula do ponto e as oito vizinhas: divisa de célula não é divisa municipal. */
    const naMalha = async (lat: number, lon: number) => {
      const i = Math.floor(lat);
      const j = Math.floor(lon);
      const ordem = [
        [i, j],
        [i, j + 1],
        [i, j - 1],
        [i + 1, j],
        [i - 1, j],
        [i + 1, j + 1],
        [i + 1, j - 1],
        [i - 1, j + 1],
        [i - 1, j - 1],
      ];
      for (const [ci, cj] of ordem) {
        const celula = await buscarCelula(ci, cj);
        if (!celula) continue;
        for (const [codigo, slug, aneis] of celula.t) {
          if (dentro(lon, lat, aneis)) return { codigo, slug };
        }
      }
      return null;
    };

    const distanciaKm = (lat1: number, lon1: number, lat2: number, lon2: number): number => {
      const raio = 6371;
      const dLat = ((lat2 - lat1) * Math.PI) / 180;
      const dLon = ((lon2 - lon1) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((lat1 * Math.PI) / 180) *
          Math.cos((lat2 * Math.PI) / 180) *
          Math.sin(dLon / 2) ** 2;
      return 2 * raio * Math.asin(Math.sqrt(a));
    };

    /** Rede de segurança para mar, represa ou falha de simplificação. */
    const maisPerto = async (lat: number, lon: number) => {
      try {
        const resposta = await fetch(`${baseGeo}api/v1/centros.json`, { cache: "force-cache" });
        const pontos = (await resposta.json()) as Ponto[];
        let melhor: Ponto | null = null;
        let menor = Infinity;
        for (const ponto of pontos) {
          const d = distanciaKm(lat, lon, ponto[0], ponto[1]);
          if (d < menor) {
            menor = d;
            melhor = ponto;
          }
        }
        return melhor ? { codigo: melhor[2], slug: melhor[3] } : null;
      } catch {
        return null;
      }
    };

    botaoGeo?.addEventListener("click", () => {
      if (!navigator.geolocation) {
        aviso("Seu navegador não permite localização.");
        return;
      }

      botaoGeo.disabled = true;
      aviso("Localizando…");

      navigator.geolocation.getCurrentPosition(
        async (posicao) => {
          const { latitude, longitude } = posicao.coords;
          aviso("Procurando o município…");
          const achado = (await naMalha(latitude, longitude)) ?? (await maisPerto(latitude, longitude));
          if (!achado) {
            aviso("Não consegui identificar o município. Use a busca.");
            botaoGeo.disabled = false;
            return;
          }
          aviso("Abrindo…");
          location.href = `${baseGeo}municipios/${achado.codigo}-${achado.slug}`;
        },
        (erro) => {
          aviso(
            erro.code === 1
              ? "Permissão negada — use a busca acima."
              : "Não consegui obter sua localização.",
          );
          botaoGeo.disabled = false;
        },
        { timeout: 10000, maximumAge: 600000 },
      );
    });
  </script>

  <style>
    .hero {
      padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    }

    .hero-in {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }

    .hero-texto {
      min-width: 0;
    }

    .hero-arte {
      position: relative;
      min-height: 380px;
    }

    .arte {
      position: absolute;
      margin: 0;
      padding: 0.9rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-card);
      box-shadow: var(--shadow-card);
      display: grid;
      place-items: center;
      background-image: conic-gradient(var(--border) 25%, var(--surface) 0 50%, var(--border) 0 75%, var(--surface) 0);
      background-size: 16px 16px;
    }

    .arte img {
      display: block;
      width: 100%;
      height: auto;
    }

    .arte--1 {
      width: 200px;
      left: 4%;
      top: 48px;
      transform: rotate(-4deg);
      z-index: 2;
    }

    .arte--2 {
      width: 168px;
      right: 4%;
      top: 0;
      transform: rotate(3deg);
      z-index: 3;
    }

    .arte--3 {
      width: 156px;
      left: 32%;
      bottom: 0;
      transform: rotate(2deg);
      z-index: 4;
    }

    @media (max-width: 960px) {
      .hero-in {
        grid-template-columns: 1fr;
      }

      .hero-arte {
        display: none;
      }
    }

    .geo {
      margin: 1.25rem 0 0;
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .geo-botao {
      font: inherit;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--accent);
      background: transparent;
      border: 0;
      border-bottom: 1px solid transparent;
      min-height: 44px;
      padding: 0.5rem 0;
      cursor: pointer;
      transition: border-color var(--dur) var(--ease);
    }

    .geo-botao:hover {
      border-bottom-color: var(--accent);
    }

    .geo-botao[disabled] {
      opacity: 0.6;
      cursor: progress;
    }

    .geo-estado {
      font-size: 0.875rem;
      color: var(--muted);
    }

    .geo-nota {
      font-size: 0.8125rem;
      color: var(--muted);
      margin: 0.25rem 0 0;
      max-width: 48ch;
    }

    .hero h1 {
      max-width: 24ch;
      margin-bottom: 1rem;
    }

    .linha-fina {
      font-size: 1.125rem;
      color: var(--muted);
      max-width: 56ch;
      margin-bottom: 1.75rem;
    }

    .numeros {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(108px, 1fr));      gap: 1rem 1.25rem;
      margin: 2rem 0 0;
