---
import { BASE as base, GITHUB } from "../lib/urls";
---

<footer class="rodape">
  <div class="wrap rodape-in">
    <p>
      <strong>coletivo.dev.br</strong> · uma iniciativa do{" "}
      <a href="https://atelie.dev.br" rel="noopener">Ateliê DEV</a>
    </p>
    <nav aria-label="Rodapé">
      <a href={`${base}contribuir`}>Relatar ou contribuir</a>
      <a href={GITHUB} rel="noopener">GitHub</a>
      <a href={`${base}cobertura`}>Cobertura</a>
      <a href={`${base}api/v1/municipios.json`}>Índice JSON</a>
      <a href={`${base}sobre`}>Sobre</a>
    </nav>
    <p class="miudo">
      Código sob AGPL-3.0 · metadados em CC0 · imagens com a licença de cada arquivo.
    </p>
  </div>
</footer>

<style>
  .rodape {
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .rodape-in {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    justify-content: space-between;
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .miudo {
    flex-basis: 100%;
    font-size: 0.8125rem;
    opacity: 0.9;
  }
</style>
