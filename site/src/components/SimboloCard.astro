---
import { BASE as base, embedUrl } from "../lib/urls";
import { tier, kb, host, type Entrada, type Item } from "../lib/dados";

interface Props {
  entrada: Entrada;
  tipo: "brasao" | "bandeira";
  item?: Item;
}

const { entrada, tipo, item } = Astro.props;
const rotulo = tipo === "brasao" ? "Brasão" : "Bandeira";
const artigo = tipo === "brasao" ? "o" : "a";
const baldeRotulo: Record<string, string> = {
  livre: "livre",
  compartilha: "compartilha",
  oficial: "oficial",
};

const t = item ? tier(item) : null;
const formatos = item
  ? (["svg", "png", "jpg"] as const).filter((f) => item.rendicoes[f])
  : [];
const principal = item && item.rendicoes.svg ? "svg" : "png";
const alvo = item ? embedUrl(entrada.c, tipo, principal) : "";
const alt = `${rotulo} de ${entrada.n}`;
const snippet = `<img src="${alvo}" alt="${alt}" width="192" height="192">`;
---

{
  !item ? (
    <article class="card vazio">
      <h2>{rotulo}</h2>
      <p class="muted">
        Ainda não temos {artigo} {rotulo.toLowerCase()} de {entrada.n}.
      </p>
      <p class="nota">
        Símbolo ausente não é símbolo inexistente: pode estar publicado pela
        prefeitura em PDF. <a href={`${base}contribuir?cod=${entrada.c}&tipo=${tipo}`}>Enviar o arquivo</a>.
      </p>
    </article>
  ) : (
    <article class="card simbolo">
      <div class="xadrez">
        <img
          src={embedUrl(entrada.c, tipo, "png")}
          alt={alt}
          width="320"
          height="320"
          decoding="async"
        />
      </div>

      <div class="info">
        <div class="info-topo">
          <h2>{rotulo}</h2>
          <span class="selo selo--tier">
            {t!.codigo} · {t!.rotulo}
          </span>
        </div>

        <dl class="detalhes">
          <div>
            <dt>Licença</dt>
            <dd class="licenca">
              <span class={`selo selo--${item.balde}`}>
                {baldeRotulo[item.balde ?? ""] ?? "?"}
              </span>{" "}
              <code>{item.licenca}</code>
            </dd>
          </div>
          {item.autor && (
            <div>
              <dt>Autor</dt>
              <dd>{item.autor}</dd>
            </div>
          )}
          <div>
            <dt>Origem</dt>
            <dd>
              {item.origem ? (
                <a href={item.origem} rel="noopener">
                  {host(item.origem)}
                </a>
              ) : (
                "não registrada"
              )}
            </dd>
          </div>
          <div>
            <dt>Formatos</dt>
            <dd class="num">
              {formatos.map((f) => `${f.toUpperCase()} ${kb(item.rendicoes[f].bytes)}`).join(" · ")}
            </dd>
          </div>
          <div>
            <dt>Revisão</dt>
            <dd>
              <span class="selo selo--revisao">não revisado</span>
            </dd>
          </div>
        </dl>

        <div class="acoes">
          <button type="button" class="btn btn--ghost" data-copiar={alvo}>
            Copiar URL
          </button>
          <button type="button" class="btn btn--ghost" data-copiar={snippet}>
            Copiar &lt;img&gt;
          </button>
          <a class="btn" href={alvo} target="_blank" rel="noopener">
            Baixar {principal.toUpperCase()}
          </a>
          <a class="btn btn--ghost" href={`${base}contribuir?cod=${entrada.c}&tipo=${tipo}`}>
            Reportar problema
          </a>
        </div>
      </div>
    </article>
  )
}

<style>
  .simbolo {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .xadrez {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    min-height: 280px;
    background-image: conic-gradient(
      var(--border) 25%,
      var(--surface) 0 50%,
      var(--border) 0 75%,
      var(--surface) 0
    );
    background-size: 16px 16px;
    border-bottom: 1px solid var(--border);
  }

  .xadrez img {
    width: 100%;
    max-width: 240px;
    height: auto;
    display: block;
  }

  .info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .info-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .info h2 {
    font-size: 1.25rem;
  }

  .detalhes {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .detalhes > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }

  .detalhes dt {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .detalhes dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .detalhes code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .selo {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--r-selo);
    padding: 2px 6px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  .selo--livre {
    color: var(--ok);
  }

  .selo--compartilha {
    color: var(--warn);
  }

  .selo--oficial {
    color: var(--stop);
  }

  .selo--tier {
    color: var(--accent);
  }

  .selo--revisao {
    color: var(--muted);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .acoes .btn {
    font-size: 0.875rem;
    min-height: 40px;
  }

  .vazio {
    padding: 1.5rem;
    border-style: dashed;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vazio h2 {
    font-size: 1.125rem;
  }

  .vazio p {
    margin: 0;
    font-size: 0.9375rem;
  }

  .nota {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
