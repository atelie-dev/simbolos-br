---
import { BASE as base } from "../lib/urls";
import { cardHtml } from "../lib/card";
import type { Entrada, Item } from "../lib/dados";

interface Props {
  entrada: Entrada;
  tipo: "brasao" | "bandeira";
  item?: Item;
}

const { entrada, tipo, item } = Astro.props;
// Markup e estilos vivem em `lib/card.ts` + `styles/cards.css`: o formulário de
// relato monta o mesmo card no navegador, e divergir seria mostrar ao usuário
// uma coisa diferente do que ele veio reportar.
const html = cardHtml(entrada, tipo, item, { base, acoes: true });
---

<Fragment set:html={html} />
