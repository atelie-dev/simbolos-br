---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/cards.css";
import { BASE as base } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Acervo aberto dos brasões e bandeiras dos municípios e estados brasileiros, com procedência e licença por arquivo.",
} = Astro.props;

// URL canônica: sem barra final e sem `.html` (o build usa `format: "file"`).
// A raiz do serviço é a exceção — ali `index.html` é o próprio diretório.
const bruto = Astro.url.pathname;
const caminho = bruto.endsWith("/index.html")
  ? bruto.slice(0, -"index.html".length)
  : bruto.endsWith(".html")
    ? bruto.slice(0, -".html".length)
    : bruto;
const canonica = new URL(caminho, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <link
      rel="preload"
      href={`${base}fonts/bricolage-grotesque.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/source-sans-3.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/json" href={`${base}api/v1/municipios.json`} />
  </head>
  <body>
    <a class="sr-only" href="#conteudo">Pular para o conteúdo</a>
    <slot />

    <script>
      // Troca de formato dentro do card. O botão carrega a URL de destino, então
      // o cliente não precisa saber o host do CDN para montar o caminho.
      document.addEventListener("click", (evento) => {
        const botao = (evento.target as HTMLElement).closest<HTMLButtonElement>("[data-fmt]");
        if (!botao) return;
        const card = botao.closest(".card.simbolo");
        const url = botao.dataset.url;
        const ext = botao.dataset.ext;
        if (!card || !url || !ext) return;

        const previa = card.querySelector<HTMLImageElement>("[data-previa]");
        if (previa) previa.src = url;

        card.querySelectorAll<HTMLButtonElement>("[data-fmt]").forEach((outro) => {
          outro.setAttribute("aria-pressed", String(outro === botao));
        });

        const baixar = card.querySelector<HTMLAnchorElement>("[data-baixar]");
        if (baixar) {
          baixar.href = url;
          baixar.textContent = `Baixar ${ext.toUpperCase()}`;
        }

        const copiarUrl = card.querySelector<HTMLButtonElement>('[data-papel="url"]');
        if (copiarUrl) copiarUrl.dataset.copiar = url;

        const copiarSnippet = card.querySelector<HTMLButtonElement>('[data-papel="snippet"]');
        if (copiarSnippet) {
          const alt = previa?.alt ?? "";
          copiarSnippet.dataset.copiar = `<img src="${url}" alt="${alt}" width="192" height="192">`;
        }
      });
    </script>
  </body>
</html>
